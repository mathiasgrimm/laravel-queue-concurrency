{
    "name": "mathiasgrimm/laravel-queue-concurrency",
    "description": "A queue driver for Laravel's Concurrency component. The same blocking Concurrency::run() API, but your closures run on queue workers and the results come back to the caller.",
    "keywords": [
        "laravel",
        "concurrency",
        "queue",
        "parallel",
        "laravel-cloud",
        "scale-to-zero"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mathias Grimm",
            "email": "mathiasgrimm@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0",
        "laravel/serializable-closure": "^1.3 || ^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.0 || ^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^2.0 || ^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "MathiasGrimm\\QueueConcurrency\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MathiasGrimm\\QueueConcurrency\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MathiasGrimm\\QueueConcurrency\\QueueConcurrencyServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
